<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fila de Distribuição de Leads</title>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f4f6f8;
    margin: 0;
    padding: 20px;
  }
  h1 {
    text-align: center;
    color: #2c3e50;
  }
  .container {
    max-width: 900px;
    margin: 0 auto;
  }
  .lead-card {
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    padding: 16px;
    margin-bottom: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
  }
  .lead-info h3 {
    margin: 0 0 6px;
    color: #2c3e50;
  }
  .lead-info p {
    margin: 2px 0;
    color: #555;
    font-size: 14px;
  }
  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: bold;
    color: #fff;
    margin-left: 6px;
  }
  .badge-pequeno { background: #3498db; }
  .badge-medio   { background: #f39c12; }
  .badge-grande  { background: #e74c3c; }

  .btn-confirmar {
    background: #25d366;
    color: #fff;
    border: none;
    padding: 10px 18px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
    font-weight: bold;
  }
  .btn-confirmar:hover { background: #1ebc59; }

  .empty {
    text-align: center;
    color: #888;
    margin-top: 40px;
    font-size: 16px;
  }

  .loading {
    text-align: center;
    color: #888;
    margin-top: 40px;
  }
</style>
</head>
<body>

<div class="container">
  <h1>📋 Fila de Distribuição de Leads</h1>
  <div id="listaLeads" class="loading">Carregando leads...</div>
</div>

<!-- Biblioteca do Supabase -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script>
  // ⚠️ SUBSTITUA pelas suas credenciais do Supabase
  const SUPABASE_URL = "https://uifwnzgkxsacxpfnqbak.supabase.co";
  const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVpZnduemdreHNhY3hwZm5xYmFrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg0NjA4MzksImV4cCI6MjEwNDAzNjgzOX0.zMmM8cAjDQd9STev26mCGFXCoUdCWOArjAQus6dGZtU";
  const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  const listaLeads = document.getElementById("listaLeads");

  // Mapeia porte para classe de cor
  function classePorte(porte) {
    if (porte === "pequeno") return "badge-pequeno";
    if (porte === "medio") return "badge-medio";
    if (porte === "grande") return "badge-grande";
    return "";
  }

  async function carregarLeads() {
    listaLeads.innerHTML = "Carregando leads...";

    // Busca leads que ainda não foram atribuídos/confirmados
    const { data: leads, error } = await supabase
      .from("leads")
      .select("*")
      .is("corretor_id", null) // ajuste esse filtro conforme sua coluna de status
      .order("created_at", { ascending: true });

    if (error) {
      listaLeads.innerHTML = `<p class="empty">Erro ao carregar leads: ${error.message}</p>`;
      return;
    }

    if (!leads || leads.length === 0) {
      listaLeads.innerHTML = `<p class="empty">Nenhum lead pendente no momento 🎉</p>`;
      return;
    }

    listaLeads.innerHTML = "";

    for (const lead of leads) {
      const corretorSugerido = await sugerirCorretor(lead);
      const card = document.createElement("div");
      card.className = "lead-card";

      card.innerHTML = `
        <div class="lead-info">
          <h3>${lead.nome || "Sem nome"}
            <span class="badge ${classePorte(lead.porte)}">${lead.porte || "-"}</span>
          </h3>
          <p>📞 ${lead.telefone || "Sem telefone"}</p>
          <p>👥 Vidas: ${lead.qtd_vidas ?? "-"}</p>
          <p>🧑‍💼 Corretor sugerido: <strong>${corretorSugerido ? corretorSugerido.nome : "Nenhum disponível"}</strong></p>
        </div>
        <button class="btn-confirmar" ${!corretorSugerido ? "disabled" : ""}>
          ✅ Confirmar e Disparar WhatsApp
        </button>
      `;

      const btn = card.querySelector("button");
      btn.addEventListener("click", () => confirmarDistribuicao(lead, corretorSugerido));

      listaLeads.appendChild(card);
    }
  }

  // Lógica simples de sugestão — ajuste conforme sua regra real de negócio
  async function sugerirCorretor(lead) {
    const { data: corretores, error } = await supabase
      .from("corretores")
      .select("*")
      .eq("ativo", true)
      .lte("leads_hoje", 4) // exemplo: limite de 5 por dia (0 a 4 = ainda tem vaga)
      .order("leads_hoje", { ascending: true })
      .limit(1);

    if (error || !corretores || corretores.length === 0) return null;
    return corretores[0];
  }

  async function confirmarDistribuicao(lead, corretor) {
    if (!corretor) return;

    // Atualiza o lead no banco, atribuindo o corretor
    const { error } = await supabase
      .from("leads")
      .update({
        corretor_id: corretor.id,
        status: "atribuido",
        atribuido_em: new Date().toISOString()
      })
      .eq("id", lead.id);

    if (error) {
      alert("Erro ao confirmar distribuição: " + error.message);
      return;
    }

    // Monta a mensagem do WhatsApp
    const mensagem = encodeURIComponent(
      `Olá ${corretor.nome}! Você recebeu um novo lead:\n\n` +
      `Nome: ${lead.nome}\n` +
      `Telefone: ${lead.telefone}\n` +
      `Qtd. de vidas: ${lead.qtd_vidas}\n` +
      `Porte: ${lead.porte}\n\n` +
      `Por favor, entre em contato o mais rápido possível!`
    );

    const numeroCorretor = corretor.telefone.replace(/\D/g, ""); // remove caracteres não numéricos
    const linkWhatsApp = `https://wa.me/55${numeroCorretor}?text=${mensagem}`;

    window.open(linkWhatsApp, "_blank");

    // Recarrega a lista (o lead confirmado vai sair da fila)
    carregarLeads();
  }

  // Carrega a lista ao abrir a página
  carregarLeads();
</script>

</body>
</html>
